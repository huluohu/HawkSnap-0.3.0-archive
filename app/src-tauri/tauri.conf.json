{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HawkSnap",
  "version": "1.0.0",
  "identifier": "com.hawksnap.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$CACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/guxiaolong/HawkSnap/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFQTU1QTZFNDY2RTVCRjEKUldUeFcyNUdibHFscmdjSWw1VmZmWndVQk9UTm11Y1NUcG9sVzNuWmsyRHYzYnNEOXFUWGF0V3QK"
    }
  }
}
